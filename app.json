{
  "expo": {
    "name": "PictoApp-migrate",
    "slug": "PictoApp-migrate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pictoappmigrate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.charlyflow.PictoAppmigrate",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Necesitamos la cámara para actualizar tu foto de perfil.",
        "NSMicrophoneUsageDescription": "Necesitamos el micrófono si grabas vídeo con la cámara.",
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tus fotos para elegir y actualizar tu imagen de perfil.",
        "NSPhotoLibraryAddUsageDescription": "Necesitamos permiso para guardar la foto en tu galería."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.charlyflow.PictoAppmigrate",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Necesitamos acceso a tus fotos.",
          "savePhotosPermission": "Necesitamos permiso para guardar la foto en tu galería.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.236235453668-o9u0q0ve7oobv34pvaprefpq8pouc155"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f4d884c-5cf5-4f84-947c-9f12df8da785"
      }
    },
    "owner": "charlyflow"
  }
}
